def encrpt_text(plaintext,n):
  ans=''
  for i in range(len(plaintext)):
    ch=plaintext[i]

    if ch==" ":
      ans+=" "
    elif(ch.isupper()):
        ans+=chr((ord(ch)+n-65)%26+65)
    else:
          ans+=chr((ord(ch)+n-97)%26+97)
  return ans
plaintext="hello"
n=4
print("original text:",plaintext)
print("shift pattern:",str(n))
print("encrypted text:",encrpt_text(plaintext,n))
